<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>AirCOM.Client.B</RootNamespace>
    <AssemblyName>AirCOM.Client.B</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="$(CommunityToolkitMvvmVersion)" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="$(HNotifyIconVersion)" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="$(HostingVersion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="$(SystemIOPortsVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AirCOM.Core\AirCOM.Core.csproj" />
  </ItemGroup>

</Project>
