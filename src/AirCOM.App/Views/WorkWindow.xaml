<Window x:Class="AirCOM.App.Views.WorkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AirCOM.App.ViewModels"
        xmlns:local="clr-namespace:AirCOM.App.Views"
        Title="{Binding WindowTitle}" Height="640" Width="760"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:InverseBoolConverter x:Key="InverseBool"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="当前角色：" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding RoleDisplay}" Foreground="DodgerBlue" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0"/>
            <Button Content="返回选择角色" Command="{Binding BackCommand}" Margin="24,0,0,0" Padding="12,2" Background="Transparent" BorderBrush="Gray"/>
        </StackPanel>

        <!-- 配置区 -->
        <GroupBox Header="配置" Grid.Row="1" Margin="0,0,0,8" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- B 端：选串口 -->
                <TextBlock Text="共享串口:" VerticalAlignment="Center" Margin="0,0,6,0"
                           Visibility="{Binding IsBSide, Converter={StaticResource BoolToVis}}"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}"
                          MinWidth="140" VerticalAlignment="Center"
                          Visibility="{Binding IsBSide, Converter={StaticResource BoolToVis}}"/>
                <Button Grid.Column="2" Content="刷新" Command="{Binding RefreshPortsCommand}" Margin="6,0,0,0" Padding="12,2"
                        Visibility="{Binding IsBSide, Converter={StaticResource BoolToVis}}"/>

                <!-- A 端：填 B 端 IP -->
                <TextBlock Grid.Column="0" Text="B 端 IP:" VerticalAlignment="Center" Margin="0,0,6,0"
                           Visibility="{Binding IsASide, Converter={StaticResource BoolToVis}}"/>
                <TextBox Grid.Column="1" Text="{Binding RemoteHost}" MinWidth="160" VerticalAlignment="Center"
                         Visibility="{Binding IsASide, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Grid.Column="2" Text="端口:" VerticalAlignment="Center" Margin="16,0,6,0"
                           Visibility="{Binding IsASide, Converter={StaticResource BoolToVis}}"/>
                <TextBox Grid.Column="3" Text="{Binding RemotePort}" MinWidth="70" VerticalAlignment="Center"
                         Visibility="{Binding IsASide, Converter={StaticResource BoolToVis}}"/>

                <!-- B 端：监听端口 -->
                <TextBlock Grid.Column="3" Text="监听端口:" VerticalAlignment="Center" Margin="16,0,6,0"
                           Visibility="{Binding IsBSide, Converter={StaticResource BoolToVis}}"/>
                <TextBox Grid.Column="4" Text="{Binding ListenPort}" MinWidth="70" VerticalAlignment="Center"
                         Visibility="{Binding IsBSide, Converter={StaticResource BoolToVis}}"/>

                <!-- A 端：虚拟口（只读显示，自动分配） -->
                <TextBlock Grid.Column="4" Text="虚拟口:" VerticalAlignment="Center" Margin="16,0,6,0"
                           Visibility="{Binding IsASide, Converter={StaticResource BoolToVis}}"/>
                <TextBox Grid.Column="5" Text="{Binding VirtualPortDisplay}" MinWidth="120" VerticalAlignment="Center" IsReadOnly="True"
                         Visibility="{Binding IsASide, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </GroupBox>

        <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,0,0,8">
            <!-- B 端：波特率可设（决定真实串口参数，唯一有效处） -->
            <TextBlock Text="波特率:" VerticalAlignment="Center" Margin="0,0,6,0"
                       Visibility="{Binding IsBSide, Converter={StaticResource BoolToVis}}"/>
            <TextBox Text="{Binding BaudRate}" MinWidth="80" VerticalAlignment="Center"
                     Visibility="{Binding IsBSide, Converter={StaticResource BoolToVis}}"/>
            <!-- A 端：波特率只读，跟随 B 端 -->
            <TextBlock Text="波特率:" VerticalAlignment="Center" Margin="0,0,6,0"
                       Visibility="{Binding IsASide, Converter={StaticResource BoolToVis}}"/>
            <TextBox Text="{Binding BaudRateDisplay}" MinWidth="120" VerticalAlignment="Center" IsReadOnly="True" Background="#F4F4F4"
                     Visibility="{Binding IsASide, Converter={StaticResource BoolToVis}}"/>
            <Button Content="{Binding ActionButtonLabel}" Command="{Binding ActionCommand}" Margin="12,0,0,0" Padding="24,6" FontWeight="Bold"
                    Background="{Binding ActionButtonColor}" Foreground="White"/>
            <TextBlock Text="{Binding Com0comStatus}" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="OrangeRed" TextWrapping="Wrap"
                       Visibility="{Binding IsASide, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>

        <TextBlock Grid.Row="3" Text="{Binding StatusText}" FontWeight="Bold" Margin="0,0,0,8" VerticalAlignment="Top"/>

        <GroupBox Header="日志" Grid.Row="3" Margin="0,28,0,0" Padding="4">
            <TextBox Text="{Binding LogText}" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
        </GroupBox>
    </Grid>
</Window>
